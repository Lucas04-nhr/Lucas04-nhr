        \intarray_gset:Nnn \g__cn_rk_intarray {##1}
          { \__cn_xor:nn { \__cn_hexpair:nn {#1} {##1} } { \__cn_hexpair:nn {#2} {##1} } }
      }
    \int_step_inline:nnn { 4 } { 43 } { \__cn_aes_key_word:n {##1} }
  }
\cs_new_protected:Npn \__cn_aes_key_word:n #1
