\int_step_inline:nnn { 0 } { 255 }
  {
    \intarray_gset:Nnn \g__cn_nxor_intarray { #1 + 1 }
      {
        \__cn_bit:nnn { \int_div_truncate:nn {#1} {16} } { \int_mod:nn {#1} {16} } {1}
