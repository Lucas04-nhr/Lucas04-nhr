% ---- Code listings ----
% Two environments, one shared tcolorbox style ("codebox") that draws one
% background per block: listings' own per-line backgroundcolor leaves hairline
% gaps in PDF viewers, and \parskip would add space between lines.
%   \begin{codeblock} ... \end{codeblock}        source code, Python by default
%   \begin{codeblock}[R] ... \end{codeblock}     any language listings knows:
%                                                 R, C, C++, Java, bash, SQL ...
%   \begin{codeblock}[] ... \end{codeblock}      plain text, no highlighting
%   \begin{outputblock} ... \end{outputblock}    program output, never highlighted
% Both break across pages. Inline code: \texttt{...}. Colours come from the
% palette above; change them here to restyle all code at once.
\RequirePackage{listings}
\RequirePackage[most]{tcolorbox}
\colorlet{cncodekw}{cnbrand}            % keywords
\colorlet{cncodecomment}{cnmuted}       % comments
\definecolor{cncodestring}{HTML}{8A5A2B} % strings: deep apricot (>= 4.5:1 on cncodebg)
% language-neutral defaults; the language is chosen per block
\lstset{basicstyle=\ttfamily\small\color{cntext},columns=fullflexible,
  keepspaces=true,breaklines=true,showstringspaces=false,upquote=true,
  keywordstyle=\color{cncodekw}\bfseries,
  commentstyle=\color{cncodecomment}\itshape,
  stringstyle=\color{cncodestring},aboveskip=0pt,belowskip=0pt}
% listing options is always set below, which also drops tcolorbox's default
% style=tcblatex (that would switch every block to LaTeX highlighting)
\tcbset{codebox/.style={listing only,enhanced,breakable,boxrule=0pt,arc=2pt,
  outer arc=2pt,left=6pt,right=6pt,top=3pt,bottom=3pt,
  before skip=6pt,after skip=6pt}}
\newtcblisting{codeblock}[1][Python]{codebox,colback=cncodebg,colframe=cncodebg,
  listing options={language={#1}}}
\newtcblisting{outputblock}{codebox,colback=white,colframe=white,arc=0pt,outer arc=0pt,
  borderline west={1.5pt}{0pt}{cnborder},listing options={language={}}}

% ---- Boxes: problems and callouts ----
% problem: a question or exercise statement, powder-blue background with a
% brand-blue rule on the left. Breaks across pages.
%   \begin{problem} Compute ... \end{problem}
% callout: an admonition box, like the ::: containers on the blog. The optional
% argument picks the type (default note); the title may be left empty.
%   types: info, note, tip, success, important, warning, danger
%   \begin{callout}[warning]{Behaviour in NumPy 2.5} ... \end{callout}
%   \begin{callout}{} an untitled note \end{callout}
\newtcolorbox{problem}{enhanced,breakable,colback=cnnotebg,colframe=cnnotebg,
  borderline west={2pt}{0pt}{cnbrand},arc=0pt,outer arc=0pt,
  left=8pt,right=6pt,top=4pt,bottom=4pt,before skip=4pt,after skip=8pt}
% title-bar colour per type: the marker tone closest in hue to the background
\colorlet{cninfotitle}{cninfomark}
\colorlet{cnnotetitle}{cninfomark}
\colorlet{cntiptitle}{cnmark}
\colorlet{cnsuccesstitle}{cntipmark}
\colorlet{cnimportanttitle}{cnimportantmark}
\colorlet{cnwarningtitle}{cnwarningmark}
\colorlet{cndangertitle}{cndangermark}
\NewTColorBox{callout}{O{note} m}{enhanced,breakable,
  colback=cn#1bg,colframe=cn#1title,coltitle=cntext,colbacktitle=cn#1title,
  fonttitle=\bfseries,arc=2pt,boxrule=0.6pt,left=6pt,right=6pt,
  before skip=6pt,after skip=8pt,
  code={\cn@ifblank{#2}{}{\tcbset{title={#2}}}}}
  
% ---- Figures and tables (adapted from hust_gp.sty); loaded before hyperref ----
% All floats: small captions, bold label, a \quad after it, centred; table captions
% go above the table. The names are "Figure"/"Table", or 图/表 with the [zh] option.
%
%   \begin{figure}[htbp]
%     \centering
%     \fig{fig/pipeline}                    % default width 0.8\linewidth
%     \bicaption{Modelling pipeline}{建模流程}\label{fig:pipeline}
%   \end{figure}
%
% Sub-figures (subcaption): \begin{subfigure}{0.45\linewidth} ... \caption{..}
% \end{subfigure}; the label reads "(a)", \ref gives "1(a)".
\RequirePackage{graphicx,caption,subcaption}
\DeclareCaptionLabelSeparator{quad}{\quad}
\captionsetup{font=small,labelfont=bf,labelsep=quad,justification=centering,skip=6pt}
\captionsetup[table]{position=top}% table captions sit above the table
\captionsetup[sub]{font=small,labelformat=simple,labelsep=space}
% \fig[<width>]{<file>}: \includegraphics with width (default 0.8\linewidth), capped
% at \cnfigmaxwidth (default \linewidth, i.e. no extra cap; an assignment can set e.g.
% \renewcommand{\cnfigmaxwidth}{0.8\textwidth}) and at 0.7\textheight in height,
% aspect ratio kept, so a figure never overflows.
\newcommand{\cnfigmaxwidth}{\linewidth}
\newcommand{\fig}[2][0.8\linewidth]{%
  \begingroup
  \setlength{\@tempdima}{#1}%
  \setlength{\@tempdimb}{\cnfigmaxwidth}%
  \ifdim\@tempdima>\@tempdimb \setlength{\@tempdima}{\@tempdimb}\fi
  \includegraphics[width=\@tempdima,height=0.7\textheight,keepaspectratio]{#2}%
  \endgroup}
% \bicaption{<English>}{<中文>}: use in place of \caption.
%   both filled    English caption, Chinese line under it in \zhstyle
%   {English}{}    plain English caption
%   {}{中文}       plain Chinese caption
% The list of figures/tables takes the English text (or the Chinese if alone).
\newcommand{\bicaption}[2]{%
  \cn@ifblank{#1}{\caption{#2}}{%
    \cn@ifblank{#2}{\caption{#1}}{\caption[#1]{#1\\{\zhstyle #2}}}}}
% Float placement (default; turn off with the [loosefloats] option). Large tables
% may sit on text pages instead of half-empty float-only pages, float-only pages
% start at the top, and a float never appears before the text that introduces it
% (flafter). Use [htbp] or [!htbp] as the placement; [H] (float package) still
% pins a float in place.
\ifcn@densefloats
  \RequirePackage{flafter}
  \renewcommand{\topfraction}{0.9}
  \renewcommand{\bottomfraction}{0.8}
  \renewcommand{\textfraction}{0.07}
  \renewcommand{\floatpagefraction}{0.75}
  \setcounter{topnumber}{3}
  \setcounter{bottomnumber}{2}
  \setcounter{totalnumber}{4}
  \setlength{\@fptop}{0pt}
\fi

% ---- Citations and references (natbib + BibTeX) ----
% Keep the references in a .bib file and end the document with
%   \bibliography{references}            % references.bib, no \bibliographystyle
% \cite{key} / \cite{a,b,c} / \cite[p.~5]{key}   superscript, in brackets: ^[1], ^[1–3]
%   Any space before it is removed, so "Gu et al.~\cite{gu2026}" sits tight.
% \citep{key}   the same number on the line: [1]   ("as shown in \citep{key}")
% \citet{key}   author and number: Gu et al. [1]
% Numbers follow the order of first citation (unsrtnat); multiple numbers are sorted
% and compressed. The list is set small with [1] labels. Its heading is
% "References", "References 参考文献" in a bilingual document (same rule as the
% table of contents), or 参考文献 with the [zh] option. To use another BibTeX
% style: \renewcommand{\cnbibstyle}{plainnat} in the preamble.
\RequirePackage[numbers,square,sort&compress]{natbib}
\setlength{\bibsep}{2pt}
\def\bibfont{\small}
\renewcommand{\bibnumfmt}[1]{[#1]}
\newcommand{\cnbibstyle}{unsrtnat}
\AtBeginDocument{\bibliographystyle{\cnbibstyle}}
\newcommand{\cn@supcite}[2][]{\cn@ifblank{#1}%
  {\textsuperscript{\citep{#2}}}{\textsuperscript{\citep[#1]{#2}}}}
\DeclareRobustCommand{\cite}{\unskip\cn@supcite}
\renewcommand{\refname}{References\@ifundefined{cn@tocbi}{}{\quad 参考文献}}

\RequirePackage[hidelinks]{hyperref}
% DOI field of the .bib entries: a link reading "doi:..."
\newcommand{\doi}[1]{\href{https://doi.org/#1}{doi:#1}}

% ---- PDF metadata: author, copyright, document ID (XMP, via hyperxmp) ----
% Every PDF carries the author, a copyright notice, a licence link and two IDs
% in its XMP metadata (shown by Acrobat: File > Properties > Additional Metadata,
% or `exiftool -xmp:all file.pdf`).
% The Author field credits the theme ("<author>, theme by Haoran Nie") and the
% Creator field names the engine. Both IDs are encrypted (see \cn@uuid below).
%   DocumentID  uuid derived from author + title: the same for every compile of
%               the same work, so a copy can be traced back to its source
%   InstanceID  uuid derived from author + title + compile time: changes on
%               every compile, identifies this particular PDF
% Defaults are set below; override any of them in the preamble:
%   \cnmetadata{title={Assignment 1}, subject={Vision and Image Processing},
%     keywords={linear algebra, derivatives}, rights={CC BY-NC-SA 4.0},
%     licenseurl={https://creativecommons.org/licenses/by-nc-sa/4.0/}}
% Keys: author, title, subject, keywords, year, rights, licenseurl, url.
\RequirePackage{hyperxmp}
\pgfkeys{/cn/meta/.is family,/cn/meta/.cd,
  author/.store in=\cn@m@author,     title/.store in=\cn@m@title,
  subject/.store in=\cn@m@subject,   keywords/.store in=\cn@m@keywords,
  year/.store in=\cn@m@year,         rights/.store in=\cn@m@rights,
  licenseurl/.store in=\cn@m@lurl,   url/.store in=\cn@m@url,
  author={Haoran Nie}, title={}, subject={}, keywords={}, year={\the\year},
  rights={All rights reserved.}, licenseurl={}, url={https://blog.lucas04.top}}
\newcommand{\cnmetadata}[1]{\pgfkeys{/cn/meta/.cd,#1}}
% \cn@ifmblank{\macro}: \cn@ifblank on the contents of a macro
\def\cn@ifmblank#1{\expandafter\cn@ifblank\expandafter{#1}}
% \cn@uuid\macro{<text>}: md5 of the text (XeTeX \mdfivesum), encrypted with
% AES-128 (one block) and stored in \macro as a uuid. The key is stored masked
% (xor with an md5, see the end of this block); decrypt an ID back to the md5 with
%   echo <uuid without dashes> | xxd -r -p | openssl enc -d -aes-128-ecb -nopad \
%     -K <key> | xxd -p
\ExplSyntaxOn
\intarray_new:Nn \g__cn_sbox_intarray { 256 }
\intarray_new:Nn \g__cn_nxor_intarray { 256 }  % xor of two nibbles
\intarray_new:Nn \g__cn_xtime_intarray { 256 } % multiplication by 2 in GF(2^8)
\intarray_new:Nn \g__cn_state_intarray { 16 }
\intarray_new:Nn \g__cn_tmp_intarray { 16 }
\intarray_new:Nn \g__cn_rk_intarray { 176 }    % round keys
\int_new:N \l__cn_a_int
\int_new:N \l__cn_b_int
\int_new:N \l__cn_c_int
\int_new:N \l__cn_d_int
\tl_new:N \l__cn_aes_tl
\cs_new:Npn \__cn_sb:n #1 { \intarray_item:Nn \g__cn_sbox_intarray { (#1) + 1 } }
\cs_new:Npn \__cn_rk:n #1 { \intarray_item:Nn \g__cn_rk_intarray {#1} }
\cs_new:Npn \__cn_xt:n #1 { \intarray_item:Nn \g__cn_xtime_intarray { (#1) + 1 } }
\cs_new:Npn \__cn_xor:nn #1#2
  {
    \int_eval:n
      {
        16 * \intarray_item:Nn \g__cn_nxor_intarray
          { \int_div_truncate:nn {#1} {16} * 16 + \int_div_truncate:nn {#2} {16} + 1 }
        + \intarray_item:Nn \g__cn_nxor_intarray
          { \int_mod:nn {#1} {16} * 16 + \int_mod:nn {#2} {16} + 1 }
      }
  }
\cs_new:Npn \__cn_xor:nnnn #1#2#3#4
  { \__cn_xor:nn { \__cn_xor:nn {#1} {#2} } { \__cn_xor:nn {#3} {#4} } }
\cs_new:Npn \__cn_xt_iii:n #1 { \__cn_xor:nn { \__cn_xt:n {#1} } {#1} }
\cs_new:Npn \__cn_bit:nnn #1#2#3
  { \int_mod:nn { \int_div_truncate:nn {#1} {#3} + \int_div_truncate:nn {#2} {#3} } {2} * #3 }
\cs_new:Npn \__cn_hexbyte:n #1
  {
    \int_compare:nNnT { \intarray_item:Nn \g__cn_state_intarray {#1} } < { 16 } { 0 }
    \int_to_hex:n { \intarray_item:Nn \g__cn_state_intarray {#1} }
  }
\cs_new:Npn \__cn_hexpair:nn #1#2
  { \exp_args:Ne \int_from_hex:n { \str_range:nnn {#1} { 2 * #2 - 1 } { 2 * #2 } } }
