% ---- Page limit ----
% \cnpagelimit {<n>}: at \end{document}, error if more than <n> pages were shipped out
% (counts pages actually output, so page-number resets do not matter)
\newcommand {\cnpagelimit}[1]{\gdef\cn@pagelimit{#1}}
\AtEndDocument {\ifdefined\cn@pagelimit
  \clearpage
  \ifnum\ReadonlyShipoutCounter>\cn@pagelimit\relax
    \PackageError {coursenotes}{Document has \the\ReadonlyShipoutCounter\space pages,
      the limit is \cn@pagelimit}{Shorten the document or raise \string\cnpagelimit.}%
  \fi\fi}

